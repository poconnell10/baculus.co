# Baculus environment configuration — EXAMPLE ONLY.
#
# Copy to `.env` (which is gitignored) and fill in real values locally.
# NEVER commit a populated `.env`. NEVER log any of these values.
#
# Security rules (enforced by convention + review, see docs/architecture/M0.md):
#   * SUPABASE_SERVICE_ROLE_KEY is a full-access credential. It must live only
#     in trusted server/CI contexts and MUST NEVER be exposed to any browser or
#     client bundle. Do not prefix it with NEXT_PUBLIC_ or similar.
#   * MASSIVE_API_KEY is a vendor secret. It must never reach a future UI layer.
#   * The publishable (anon) key is the only key that may reach a browser.

# --- Market-data vendor (Massive) --------------------------------------------
MASSIVE_API_KEY=
# Optional override of the Massive base URL (defaults are set in code/config).
MASSIVE_BASE_URL=

# --- Supabase control plane (Postgres + Storage) -----------------------------
SUPABASE_URL=
# Browser-safe, row-level-security-scoped key. Safe for a future client.
SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY. Bypasses RLS. Never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Operational -------------------------------------------------------------
# Dead-man's-switch / heartbeat endpoint for scheduled jobs (future use).
HEARTBEAT_URL=

# --- Local engine settings (non-secret) --------------------------------------
# Where the local POC object store writes raw/canonical artifacts.
BACULUS_DATA_ROOT=./_data
# Vendor fetch mode: "fixture" (deterministic, offline) or "live".
BACULUS_FETCH_MODE=fixture

# --- Control plane (Postgres) ------------------------------------------------
# The control plane is Postgres (Supabase for the hosted POC; a containerized
# Postgres for local dev/tests). There is no SQLite fallback. Point tests/proof
# at a Postgres maintenance DSN (a DB the role may CREATE/DROP databases from).
BACULUS_TEST_ADMIN_URL=postgresql://baculus:baculus@localhost:5432/postgres
BACULUS_PROOF_ADMIN_URL=postgresql://baculus:baculus@localhost:5432/postgres
