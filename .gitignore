# --- Secrets: never commit real credential files -----------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.secrets/

# --- Supabase CLI local state (never commit) ---------------------------------
# `supabase link` / CLI commands write local project state + a temp dir here.
# It may contain project refs and must never be committed.
supabase/.temp/
supabase/.branches/
.supabase/

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Local data / generated artifacts (must never be committed) ---------------
# Raw vendor payloads and canonical datasets belong in object storage, never git.
_data/
data/
*.parquet
*.duckdb
*.sqlite
*.sqlite3
*.db

# Evidence outputs are generated by scripts/prove_m0.py; keep the directory,
# not its generated contents.
docs/evidence/*
!docs/evidence/.gitkeep
!docs/evidence/README.md

# --- Editor / OS --------------------------------------------------------------
.DS_Store
.idea/
.vscode/
